" Keep Vim comfortable without adding plugins.
set nocompatible
syntax on
filetype plugin indent on

set number
set ruler
set showcmd
set wildmenu

set incsearch
set hlsearch
set ignorecase
set smartcase

set backspace=indent,eol,start
set autoindent
set expandtab
set tabstop=4
set shiftwidth=4
set softtabstop=4

set splitbelow
set splitright
